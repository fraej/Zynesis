#!/usr/bin/env bash
set -euo pipefail

prefix=${CARLA_PREFIX:-"$HOME/.local/carla"}
install_prefix="$prefix/usr"
export PATH="$install_prefix/lib/carla:$install_prefix/bin:${PATH}"
export PYTHONPATH="$install_prefix/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$install_prefix/lib/x86_64-linux-gnu:/tmp/zyn-vst3-prefix/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec python3 "$install_prefix/share/carla/carla" \
    --with-appname="$0" --with-libprefix="$install_prefix" "$@"
